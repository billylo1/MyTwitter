rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    function memberEnabled() {
      return isMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.enabled != false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Usage + last refreshed — members only.
    match /config/public {
      allow read: if memberEnabled();
      allow write: if false;
    }

    // Allowlist / invites / oauth sessions — Admin SDK only.
    match /config/{docId} {
      allow read, write: if false;
    }

    match /invites/{code} {
      allow read, write: if false;
    }

    match /oauthSessions/{state} {
      allow read, write: if false;
    }

    // Own membership only (no family directory).
    match /members/{memberId} {
      allow read: if memberEnabled() && isOwner(memberId);
      allow write: if false;
    }

    // Own feed only.
    match /users/{uid}/posts/{postId} {
      allow read: if memberEnabled() && isOwner(uid);
      allow write: if false;
    }

    match /users/{uid}/authors/{authorId} {
      allow read: if memberEnabled() && isOwner(uid);
      allow write: if false;
    }

    // Tokens and sync metadata — Admin SDK only.
    match /users/{uid} {
      allow read, write: if false;

      match /sync/{docId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
