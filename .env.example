# X Developer Portal — OAuth 2.0 Client (Confidential)
X_CLIENT_ID=
X_CLIENT_SECRET=

# App-only bearer (usage stats + app-only reads)
X_BEARER_TOKEN=

# OAuth 1.0a consumer key/secret (optional fallback)
X_API_KEY=
X_API_SECRET=

# Must match a Callback URI registered on the X app exactly
X_CALLBACK_URL=http://localhost:8765/callback

# Path to a Firebase service account JSON (for the OAuth script)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
