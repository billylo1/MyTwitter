# --- X Developer Portal — OAuth 2.0 Client (Confidential) ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# App-only bearer (usage stats + app-only reads)
X_BEARER_TOKEN=

# OAuth 1.0a consumer key/secret (uploaded by set-secrets.sh; used for OAuth1 sync fallback)
X_API_KEY=
X_API_SECRET=

# Production X OAuth callback (must match X Developer Portal exactly):
# https://YOUR_PROJECT_ID.web.app/oauth/callback
# Local CLI oauth still uses:
X_CALLBACK_URL=http://localhost:8765/callback

# Required to call syncNow (?key=...). Generate: openssl rand -hex 24
SYNC_NOW_KEY=

# Optional — Cloud Functions / mobile Sentry. Leave unset to disable (recommended for forks).
# Functions: set-secrets.sh writes SENTRY_DSN into gitignored functions/.env.<projectId>
# Android: android/local.properties → sentry.dsn=…  (or export SENTRY_DSN)
# iOS: ios/Config.xcconfig → SENTRY_DSN = https:/$()/…
# iOS dSYM upload (Fastlane): also needs SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
# SENTRY_DSN=

# Path to a Firebase service account JSON (for OAuth / bootstrap scripts).
# Also uploaded as ADMIN_SDK_CREDENTIALS for minting custom tokens in Cloud Functions.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Optional overrides (otherwise read from .firebaserc)
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Bootstrap allowlist (required for npm run bootstrap)
# ADMIN_HANDLE=yourhandle
# EXTRA_HANDLES=friend1,friend2
# ADMIN_X_USER_ID=

# --- Cloud Functions params (separate file under functions/) ---
# After you set .firebaserc, also create `functions/.env.<your-project-id>` with:
# SITE_URL=https://YOUR_PROJECT_ID.web.app
