rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public pointer to the default feed uid (no secrets).
    match /config/public {
      allow read: if true;
      allow write: if false;
    }

    // Public feed posts for a user (v1: Billy). Later gate with auth.
    match /users/{uid}/posts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid}/authors/{authorId} {
      allow read: if true;
      allow write: if false;
    }

    // Tokens and sync metadata — Admin SDK only.
    match /users/{uid} {
      allow read, write: if false;

      match /sync/{docId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
